# PostgreSQL connection string (serverless/pooled). Supabase Vercel
# integration sets POSTGRES_URL automatically (aws-<region>.pooler.supabase.com:6543).
POSTGRES_URL=

# Direct (non-pooled) connection used by `drizzle-kit migrate`. Supabase
# users: db.<project-ref>.supabase.co:5432.
POSTGRES_URL_NON_POOLING=

# Secret used to encrypt per-paste keys at rest. Generate a strong random value,
# e.g. `openssl rand -hex 32`. Keep this stable across deploys or pastes break.
PASTE_MASTER_KEY=replace-with-a-long-random-string

# Public base URL of the app (used to build shareable links).
APP_URL=https://your-app.vercel.app

# Upstash Redis (Vercel KV) credentials for rate limiting (optional for local dev).
# Vercel's "KV" integration (Upstash) provides KV_REST_API_URL / KV_REST_API_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Self-hosting only (not needed on Vercel): the request header your reverse
# proxy sets to the real client IP, e.g. cf-connecting-ip or x-real-ip. Rate
# limits are per IP; without a trusted header all clients share one limit.
TRUSTED_IP_HEADER=

# Secret that the /api/cron/cleanup endpoint expects in the Authorization header.
CRON_SECRET=replace-with-a-random-string

# Vercel Blob store (private access). Create a Blob store in the Vercel
# Storage tab and paste the BLOB_READ_WRITE_TOKEN value here.
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token
